# Slack App Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# Required for permission approval system
APPROVAL_HMAC_SECRET=generate-with-openssl-rand-hex-32

# User and Channel Access Control
ALLOWED_SLACK_USER_IDS=U1234567890,U0987654321
ALLOWED_SLACK_CHANNEL_IDS=C1234567890,C0987654321
ALLOW_DMS=true

# Working Directory Configuration
BASE_DIRECTORY=/Users/username/Code/
DEFAULT_WORKING_DIRECTORY=/path/to/default/project

# YOLO Auto-Approval Configuration
YOLO_LEVEL=0                     # Global default level (0-4)
                                # 0 = Safe (always prompt)
                                # 1 = Read-Only (auto-approve reads)
                                # 2 = Low-Risk (reads + safe commands)
                                # 3 = Medium-Risk (+ file ops in working dir)
                                # 4 = Full YOLO (auto-approve almost everything)
YOLO_ALLOW_PER_USER=true        # Allow users to set their own YOLO levels
YOLO_ALLOW_PER_CHANNEL=true     # Allow per-channel YOLO levels
YOLO_ALLOW_PER_THREAD=true      # Allow per-thread YOLO levels

# Claude Code Provider Configuration (optional)
CLAUDE_CODE_USE_BEDROCK=1
CLAUDE_CODE_USE_VERTEX=1

# Development Configuration
BOT_DEBUG=false
NODE_ENV=production